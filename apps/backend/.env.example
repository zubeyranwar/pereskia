# Copy this file to .env.local (git-ignored) and fill it in. Bun loads it automatically.

# Invitation emails. Optional: you can also set this up in the setup wizard or in
# Settings → Email. Anything set here wins over those settings.
RESEND_API_KEY=
# Or any SMTP server instead of Resend:
# SMTP_URL=smtps://user:pass@smtp.example.com:465
# Must be on a domain verified in Resend. Until then, leave it unset: the default
# onboarding@resend.dev sender only delivers to your own Resend account's email.
# MAIL_FROM="Pereskia <invites@yourdomain.com>"

# Public URL used in emailed links (defaults to the inviting admin's browser origin).
# APP_URL=https://yourapp.com
